# ─────────────────────────────────────────────────────────────────────────────
#  Обязательное
# ─────────────────────────────────────────────────────────────────────────────

# Сгенерировать свой: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_random_hex_64_chars

# Пароль базы. Приложение не стартует, если он не задан.
POSTGRES_PASSWORD=your_password_here

# ─────────────────────────────────────────────────────────────────────────────
#  Первый администратор
# ─────────────────────────────────────────────────────────────────────────────
# Создаётся при первом запуске, если операторов ещё нет. Если оператор с таким
# tg уже есть, но без пароля — пароль ему проставится. После первого входа обе
# переменные можно убрать.
ADMIN_INIT_TG=@your_tg_username
ADMIN_INIT_PASSWORD=change_me

# ─────────────────────────────────────────────────────────────────────────────
#  Инфраструктура
# ─────────────────────────────────────────────────────────────────────────────

# Redis (история/KV для n8n)
REDIS_URL=redis://redis:6379

# RabbitMQ (очереди сообщений Python ↔ n8n)
RABBITMQ_URL=amqp://vpnbot:vpnbot@rabbitmq/

# PostgreSQL. Хост/порт менять только при запуске вне docker-compose,
# например POSTGRES_HOST=127.0.0.1 и POSTGRES_PORT=15432.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vpnbot
POSTGRES_USER=vpnbot

# Qdrant — векторная БД под базу знаний
QDRANT_URL=http://qdrant:6333

# pgAdmin на http://localhost:5050 (переменные docker-compose, не приложения)
PGADMIN_EMAIL=admin@vpnbot.local
PGADMIN_PASSWORD=change_me

# ─────────────────────────────────────────────────────────────────────────────
#  Веб-сервер и публичные ссылки
# ─────────────────────────────────────────────────────────────────────────────

WEB_HOST=0.0.0.0
WEB_PORT=8000

# Внешний адрес панели — только схема и хост, без пути.
# ОБЯЗАТЕЛЕН, чтобы n8n мог забрать вложение и переслать его в Telegram:
# без него ссылки на файлы будут относительными и n8n их не скачает.
BASE_URL=

# Подпуть, который nginx проксирует НЕ срезая. Если nginx отдаёт приложению
# /files/api/... как есть — поставьте BASE_URL_PATH=/files. Обычно пусто.
BASE_URL_PATH=

# ─────────────────────────────────────────────────────────────────────────────
#  n8n
# ─────────────────────────────────────────────────────────────────────────────

# Если задан — исходящие события уходят POST-ом на этот вебхук вместо очереди
# RabbitMQ vpn_bot.outgoing. Очередь остаётся резервом: если вебхук не ответил
# после ретраев, сообщение публикуется в неё как раньше.
#   N8N_WEBHOOK_URL=https://n8n.example.com/webhook/vpn-bot-outgoing
N8N_WEBHOOK_URL=

# Ключ, которым n8n авторизуется при загрузке файлов в панель и который панель
# шлёт в заголовке X-API-Key на вебхук выше. Любая случайная строка:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
N8N_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  Файлы
# ─────────────────────────────────────────────────────────────────────────────

# Каталог для вложений на локальном диске
UPLOADS_DIR=app/uploads

# S3-совместимое хранилище вместо локального диска — включается, когда заданы
# S3_BUCKET и S3_ACCESS_KEY. Подходит AWS S3, Cloudflare R2, MinIO, Yandex
# Object Storage. Оставьте пустым, чтобы файлы лежали в UPLOADS_DIR.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# CDN или свой домен для публичных ссылок на файлы; пусто — ссылки строятся
# по S3_ENDPOINT_URL.
S3_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────────────────
#  AI
# ─────────────────────────────────────────────────────────────────────────────

# Провайдер для классификации и чанкинга базы знаний: "openai" или "gemini"
CHAT_PROVIDER=openai

# OpenAI — обязателен для эмбеддингов базы знаний в любом случае,
# и используется для чата при CHAT_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Gemini — заполнить при CHAT_PROVIDER=gemini (эмбеддинги всё равно через OpenAI)
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  Сервис по умолчанию (мультитенантность)
# ─────────────────────────────────────────────────────────────────────────────
# При первом запуске создаётся один ВПН-сервис, на него переносятся все
# диалоги, база знаний, шаблоны и настройки. Слаг используется в ключах Redis,
# в поле service для n8n и в имени коллекции Qdrant; менять его после первого
# запуска нельзя. Остальные ВПН-ы добавляются в панели: Настройки → Сервисы.
DEFAULT_SERVICE_SLUG=gruvpn
DEFAULT_SERVICE_NAME=GruVPN

# ─────────────────────────────────────────────────────────────────────────────
#  Что настраивается НЕ здесь
# ─────────────────────────────────────────────────────────────────────────────
# Источник данных о клиентах (профиль, ключи, рефералы, бан, реф.баланс) —
#   Настройки → Клиенты, на каждый ВПН-сервис отдельно.
# Мониторинг серверов и ботов — Состояние → Источник данных, тоже на сервис.
# Оба хранятся в базе, а не в .env: см. README, разделы «Карточка клиента:
# подключение своего API» и «Мониторинг: свой источник данных».
