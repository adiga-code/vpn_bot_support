    {
      "parameters": { "httpMethod": "POST", "path": "vpn-bot-outgoing", "options": {} },
      "id": "b6e4e885-392b-4cb5-9a98-f940878b34ef",
      "name": "Webhook исходящих",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [400, 4560],
      "webhookId": "vpn-bot-outgoing"
    },
    {
      "parameters": {
        "jsCode": "// Проверка API-ключа и распаковка тела вебхука.\n// ИМЯ НОДЫ НЕ МЕНЯТЬ — на неё ссылаются через $('Распарсить JSON').\nconst item = $input.first().json;\nconst headers = item.headers || {};\nconst expected = $vars.N8N_API_KEY || '';\n\nif (expected && headers['x-api-key'] !== expected) {\n  console.error('Webhook: неверный X-API-Key, событие отброшено');\n  return [];\n}\n\nconst raw = item.body;\nif (!raw) return [];\n\ntry {\n  const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n  return [{ json: parsed }];\n} catch (error) {\n  console.error('JSON parse error:', error.message);\n  return [{ json: { type: 'parse_error', error: error.message, raw } }];\n}"
      },
      "id": "099fe748-f911-4851-826b-260eb8af6e7e",
      "name": "Распарсить JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [624, 4560]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
                "conditions": [
                  {
                    "id": "sw-r1",
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "manager_message",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "manager_message"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
                "conditions": [
                  {
                    "id": "sw-r2",
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "send_to_user",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "send_to_user"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
                "conditions": [
                  {
                    "id": "sw-r3",
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "operator_notify",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "operator_notify"
            }
          ]
        },
        "options": {}
      },
      "id": "6261a4e3-22d1-4c2e-95f4-f2a029c0ec14",
      "name": "Switch по type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1072, 4528]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst out = {\n  dialog_id: d.dialog_id,\n  chat_id: String(d.chat_id),\n  message: d.message || '',\n  message_id: d.message_id\n};\nif (d.file_url) {\n  out.file_id = d.file_url;\n  out.file_type = d.file_type || 'document';\n} else if (d.file_id) {\n  out.file_id = d.file_id;\n  out.file_type = d.file_type || 'document';\n}\nreturn [{ json: out }];"
      },
      "id": "6b7f8f76-f0fa-49ad-9baa-23bcc89c4b46",
      "name": "Подготовить файл",
