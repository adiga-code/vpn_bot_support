      "id": "33c62929-e91a-4cf7-8eaf-afc10a2912b3",
      "name": "Отправить текст пользователю",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1744, 4272]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst event = d.event;\nconst svc = d.service_name || d.service || '';\nconst tag = svc ? `[${svc}] ` : '';\nconst texts = {\n  new_dialog:      () => `${tag}📩 Новый диалог\\nПользователь: ${d.username || d.dialog_id}`,\n  operator_called: () => `${tag}🆘 Вызов оператора\\nПользователь: ${d.username || d.dialog_id}`,\n  dialog_closed:   () => `${tag}✅ Диалог закрыт\\nОператор: ${d.operator_name || '—'}\\nID: ${d.dialog_id}`,\n  ai_toggled:      () => `${tag}🤖 ИИ ${d.ai_enabled ? 'включён ✅' : 'выключен ❌'}\\nДиалог: ${d.dialog_id}`,\n  server_down:     () => `${tag}🔴 Сервер недоступен: ${d.server_name || '—'} ${d.location || ''}\\n${d.reason || ''}`,\n  bot_down:        () => `${tag}🔴 Бот недоступен: ${d.server_name || '—'}\\n${d.reason || ''}`,\n};\nconst text = texts[event] ? texts[event]() : `${tag}[${event}] ${JSON.stringify(d)}`;\nreturn [{ json: { text, service: d.service || '' } }];"
      },
      "id": "da1766c6-b9eb-4129-853b-95fad486b9ab",
      "name": "Форматировать уведомление",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1296, 4464]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Операторы этого ВПН-а: по флагу доступа, плюс все админы\n-- (у админа флаги не выставляются, он видит все сервисы).\nSELECT DISTINCT o.tg_id\nFROM operators o\nLEFT JOIN operator_services os ON os.operator_id = o.id\nLEFT JOIN services s ON s.id = os.service_id\nWHERE o.tg_id IS NOT NULL\n  AND (o.role = 'admin' OR s.slug = $1)",
        "options": { "queryReplacement": "={{ $json.service }}" }
      },
      "id": "611a7015-9980-46f1-8aa7-7d29f10bcea9",
      "name": "Получить tg_id операторов",
